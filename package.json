{
  "name": "plataforma-agendamento-mockup",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "build:preview": "node scripts/build-preview.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "node tests/e2e/application.test.mjs",
    "test:use-cases": "node tests/e2e/useCases.test.mjs",
    "test:appearance": "node tests/e2e/appearance.test.mjs",
    "format": "prettier --write \"src/**/*.{vue,ts,css}\" \"tests/**/*.{ts,mjs}\" \"docs/*.md\"",
    "format:check": "prettier --check \"src/**/*.{vue,ts,css}\" \"tests/**/*.{ts,mjs}\" \"docs/*.md\""
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
  }
}
